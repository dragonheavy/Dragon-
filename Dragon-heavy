-- ===== JOGADORES =====
secao("JOGADORES")

local nomeBox = caixa("Nome do Jogador")

botao("🎯 TP para Jogador", function()
    local nome = nomeBox.Text:lower()
    if nome == "" then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and (p.Name:lower():find(nome) or p.DisplayName:lower():find(nome)) then
            local hrp = getHRP()
            local targetChar = p.Character
            if hrp and targetChar then
                local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 3, 0)
                end
            end
            return
        end
    end
end)

botao("👥 Trazer Todos para Mim", function()
    local hrp = getHRP()
    if not hrp then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                targetHRP.CFrame = hrp.CFrame + Vector3.new(5, 3, 5)
            end
        end
    end
end)

botao("📋 Listar Jogadores (Console)", function()
