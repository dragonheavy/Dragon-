-- DASH
local db = btn(sc, "DASH (Frente)")
db.MouseButton1Click:Connect(function()
    local r = hrp()
    if not r then return end
    local look = cam.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude > 0 then look = look.Unit end
    r.CFrame = r.CFrame + look * 15
    db.BackgroundColor3 = Color3.fromRGB(180, 10, 10)
    task.wait(0.15)
    db.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
end)

