btnWASD.MouseButton1Click:Connect(function()
    wasdAtivo = not wasdAtivo
    btnWASD.Text = "JOYSTICK > WASD - " .. (wasdAtivo and "ON" or "OFF")
    btnWASD.BackgroundColor3 = wasdAtivo and Color3.fromRGB(180, 10, 10) or Color3.fromRGB(25, 25, 25)
end)

local teclasAtivas = {
    [Enum.KeyCode.W] = false,
    [Enum.KeyCode.A] = false,
    [Enum.KeyCode.S] = false,
    [Enum.KeyCode.D] = false,
}

local function setTecla(key, estado)
    if teclasAtivas[key] == estado then return end
    teclasAtivas[key] = estado
    pcall(function() VIM:SendKeyEvent(estado, key, false, game) end)
end

local function soltarTodas()
    for k, _ in pairs(teclasAtivas) do setTecla(k, false) end
end

RunService.RenderStepped:Connect(function()
    if not wasdAtivo then soltarTodas() return end
    
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local md = hum.MoveDirection
    if md.Magnitude < 0.1 then soltarTodas() return end
    
    local look = cam.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude > 0 then look = look.Unit end
    
    local right = cam.CFrame.RightVector
    right = Vector3.new(right.X, 0, right.Z)
    if right.Magnitude > 0 then right = right.Unit end
    
    local dotF = md:Dot(look)
    local dotR = md:Dot(right)
    local lim = 0.35
    
    setTecla(Enum.KeyCode.W, dotF > lim)
    setTecla(Enum.KeyCode.S, dotF < -lim)
    setTecla(Enum.KeyCode.D, dotR > lim)
    setTecla(Enum.KeyCode.A, dotR < -lim)
end)

