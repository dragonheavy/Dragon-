local P = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local LP = P.LocalPlayer
local cam = workspace.CurrentCamera

local parent = gethui and gethui() or LP:WaitForChild("PlayerGui")
for _, n in ipairs({"DH_M", "DH_S", "DH_W"}) do
    if parent:FindFirstChild(n) then parent[n]:Destroy() end
end

local function new(t, p)
    local i = Instance.new(t)
    for k, v in pairs(p) do i[k] = v end
    return i
end

local function hum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function hrp()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function press(k)
    VIM:SendKeyEvent(true, k, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, k, false, game)
end

local function btn(pai, txt, h)
    local b = new("TextButton", {
        Parent = pai,
        Size = UDim2.new(1, -10, 0, h or 42),
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        BackgroundTransparency = 0.25,
        Text = txt,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        BorderSizePixel = 0,
    })
    new("UICorner", {Parent = b, CornerRadius = UDim.new(0, 8)})
    new("UIStroke", {Parent = b, Color = Color3.fromRGB(220, 20, 20), Thickness = 2})
    return b
end

-- ===== VELOCIDADE E PULO =====
local vel, pulo = 16, 50

local function aplicVel()
    local h = hum()
    if h then h.WalkSpeed = vel end
end

local function aplicPulo()
    local h = hum()
    if h then h.UseJumpPower = true h.JumpPower = pulo end
end

