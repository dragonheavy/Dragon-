local touchBtn = makeBtn(sc, "TOQUE > MOUSE - OFF", 42)
local touchAtivo = false

touchBtn.MouseButton1Click:Connect(function()
    touchAtivo = not touchAtivo
    if touchAtivo then
        tween(touchBtn, 0.15, {BackgroundColor3 = COLOR.accent, BackgroundTransparency = 0})
        touchBtn.Text = "TOQUE > MOUSE - ON"
    else
        tween(touchBtn, 0.15, {BackgroundColor3 = COLOR.bg2, BackgroundTransparency = ALPHA})
        touchBtn.Text = "TOQUE > MOUSE - OFF"
    end
end)

local toques = {}

UserInput.InputBegan:Connect(function(input, gp)
    if not touchAtivo or gp then return end
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    toques[input] = true
    pcall(function() VIM:SendMouseButtonEvent(input.Position.X, input.Position.Y, 0, true, game, true) end)
end)

UserInput.InputChanged:Connect(function(input)
    if not touchAtivo then return end
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not toques[input] then return end
    pcall(function() VIM:SendMouseMoveEvent(input.Position.X, input.Position.Y, true, game) end)
end)

UserInput.InputEnded:Connect(function(input)
    if not touchAtivo then return end
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not toques[input] then return end
    toques[input] = nil
    pcall(function() VIM:SendMouseButtonEvent(input.Position.X, input.Position.Y, 0, false, game, true) end)
end)

