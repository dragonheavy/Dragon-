-- Painel
local function makePanel(nome, size, pos, titulo, semFechar)
    local gui = novo("ScreenGui", {
        Name = nome,
        ResetOnSpawn = false,
        Parent = parent,
    })

    local panel = novo("Frame", {
        Parent = gui,
        Size = size,
        Position = pos,
        BackgroundColor3 = COLOR.bg,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
        Active = true,
        Draggable = not posLocked,
    })
    novo("UICorner", {Parent = panel, CornerRadius = UDim.new(0, 12)})
    novo("UIStroke", {Parent = panel, Color = COLOR.stroke, Thickness = 1.5, Transparency = 0.2})

    local header = novo("Frame", {
        Parent = panel,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = COLOR.header,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
    })
    novo("UICorner", {Parent = header, CornerRadius = UDim.new(0, 12)})

    novo("TextLabel", {
        Parent = header,
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = titulo,
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Minimizar
    local min = novo("TextButton", {
        Parent = header,
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, semFechar and -28 or -54, 0.5, -11),
        BackgroundColor3 = Color3.fromRGB(40, 10, 10),
        BackgroundTransparency = 0.3,
        Text = "-",
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })
    novo("UICorner", {Parent = min, CornerRadius = UDim.new(0, 6)})

    -- Fechar
    if not semFechar then
        local close = novo("TextButton", {
            Parent = header,
            Size = UDim2.new(0, 22, 0, 22),
            Position = UDim2.new(1, -28, 0.5, -11),
            BackgroundColor3 = Color3.fromRGB(40, 10, 10),
            BackgroundTransparency = 0.3,
            Text = "X",
            TextColor3 = COLOR.text,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            BorderSizePixel = 0,
            AutoButtonColor = false,
        })
        novo("UICorner", {Parent = close, CornerRadius = UDim.new(0, 6)})
        close.MouseButton1Click:Connect(function()
            confirmar(gui)
        end)
    end

    local minz = false
    min.MouseButton1Click:Connect(function()
        minz = not minz
        if minz then
            tween(panel, 0.2, {Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 34)})
            min.Text = "+"
        else
            tween(panel, 0.2, {Size = size})
            min.Text = "-"
        end
    end)

    table.insert(allPanels, panel)
    return gui, panel
end

local function makeBtn(pai, txt, h)
    local b = novo("TextButton", {
        Parent = pai,
        Size = UDim2.new(1, -20, 0, h or 40),
        BackgroundColor3 = COLOR.bg2,
        BackgroundTransparency = ALPHA,
