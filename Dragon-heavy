-- Paleta de cores
local COLOR = {
    bg        = Color3.fromRGB(18, 18, 20),
    bg2       = Color3.fromRGB(28, 28, 32),
    bg3       = Color3.fromRGB(38, 38, 44),
    header    = Color3.fromRGB(190, 15, 15),
    accent    = Color3.fromRGB(220, 30, 30),
    accent2   = Color3.fromRGB(255, 60, 60),
    text      = Color3.fromRGB(245, 245, 245),
    stroke    = Color3.fromRGB(230, 30, 30),
    strokeDim = Color3.fromRGB(120, 20, 20),
}

local ALPHA = 0.15

-- Helpers
local function make(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function rootpart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function pressKey(key)
    VIM:SendKeyEvent(true, key, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, key, false, game)
end

local function tween(obj, time, props)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

-- Componentes

local function makePanel(guiName, size, position, titleText)
    local gui = make("ScreenGui", {
        Name = guiName,
        ResetOnSpawn = false,
        Parent = parent,
    })

    local panel = make("Frame", {
        Parent = gui,
        Size = size,
        Position = position,
        BackgroundColor3 = COLOR.bg,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
        Active = true,
        Draggable = true,
    })
    make("UICorner", {Parent = panel, CornerRadius = UDim.new(0, 12)})
    make("UIStroke", {
        Parent = panel,
        Color = COLOR.stroke,
        Thickness = 1.5,
        Transparency = 0.2,
    })

    local shadow = make("Frame", {
        Parent = panel,
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = COLOR.stroke,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        ZIndex = -1,
    })
    make("UICorner", {Parent = shadow, CornerRadius = UDim.new(0, 12)})

    local header = make("Frame", {
        Parent = panel,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = COLOR.header,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
    })
    make("UICorner", {Parent = header, CornerRadius = UDim.new(0, 12)})
    make("Frame", {
        Parent = header,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = COLOR.header,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
    })

    make("TextLabel", {
        Parent = header,
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local close = make("TextButton", {
        Parent = header,
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -28, 0.5, -11),
        BackgroundColor3 = Color3.fromRGB(40, 10, 10),
        BackgroundTransparency = 0.3,
        Text = "X",
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })
    make("UICorner", {Parent = close, CornerRadius = UDim.new(0, 6)})

    close.MouseEnter:Connect(function()
        tween(close, 0.15, {BackgroundColor3 = COLOR.accent, BackgroundTransparency = 0})
    end)
    close.MouseLeave:Connect(function()
        tween(close, 0.15, {
            BackgroundColor3 = Color3.fromRGB(40, 10, 10),
            BackgroundTransparency = 0.3,
        })
    end)
    close.MouseButton1Click:Connect(function() gui:Destroy() end)

    return gui, panel, header
end

local function makeButton(parent, text, height)
    local btn = make("TextButton", {
        Parent = parent,
        Size = UDim2.new(1, -20, 0, height or 40),
        BackgroundColor3 = COLOR.bg2,
        BackgroundTransparency = ALPHA,
        Text = text,
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })
    make("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
    make("UIStroke", {Parent = btn, Color = COLOR.strokeDim, Thickness = 1})

    btn.MouseEnter:Connect(function()
        tween(btn, 0.15, {BackgroundColor3 = COLOR.bg3, BackgroundTransparency = 0})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.15, {BackgroundColor3 = COLOR.bg2, BackgroundTransparency = ALPHA})
    end)

    return btn
end

