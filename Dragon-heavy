close.MouseButton1Click:Connect(function() gui:Destroy() end)

-- ===== FUNÇÃO QUE SIMULA A TECLA =====
local function apertarTecla(keyCode)
    -- Pressiona
    VIM:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.05)
    -- Solta
    VIM:SendKeyEvent(false, keyCode, false, game)
end

-- ===== BOTÃO F =====
local btnF = Instance.new("TextButton", main)
btnF.Size = UDim2.new(0, 90, 0, 70)
btnF.Position = UDim2.new(0, 12, 0, 45)
btnF.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
btnF.Text = "✈️\nF"
btnF.TextColor3 = Color3.fromRGB(255, 255, 255)
btnF.Font = Enum.Font.GothamBold
btnF.TextSize = 22
btnF.BorderSizePixel = 0
Instance.new("UICorner", btnF).CornerRadius = UDim.new(0, 8)
local sf = Instance.new("UIStroke", btnF)
sf.Color = Color3.fromRGB(220, 20, 20)
sf.Thickness = 2

btnF.MouseButton1Click:Connect(function()
    btnF.BackgroundColor3 = Color3.fromRGB(180, 10, 10)
    task.wait(0.15)
    btnF.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    apertarTecla(Enum.KeyCode.F)
end)

