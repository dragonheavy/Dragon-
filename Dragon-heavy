local dashBtn = makeButton(scrollMain, "DASH (Frente)", 40)
dashBtn.MouseButton1Click:Connect(function()
    local r = rootpart()
    if not r then return end
    local look = cam.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude > 0 then look = look.Unit end
    r.CFrame = r.CFrame + look * 15

    dashBtn.BackgroundColor3 = COLOR.accent
    task.wait(0.15)
    dashBtn.BackgroundColor3 = COLOR.bg2
end)

