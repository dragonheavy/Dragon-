-- Componentes
local function makePanel(guiName, size, position, titleText, noClose)
    local gui = make("ScreenGui", {
        Name = guiName,
        ResetOnSpawn = false,
        Parent = parent,
    })

    local panel = make("Frame", {
        Parent = gui,
        Size = size,
        Position = position,
        BackgroundColor3 = COLOR.bg,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
        Active = true,
        Draggable = not posLocked,
    })
    make("UICorner", {Parent = panel, CornerRadius = UDim.new(0, 12)})
    make("UIStroke", {
        Parent = panel,
        Color = COLOR.stroke,
        Thickness = 1.5,
        Transparency = 0.2,
    })

    local shadow = make("Frame", {
        Parent = panel,
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = COLOR.stroke,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        ZIndex = -1,
    })
    make("UICorner", {Parent = shadow, CornerRadius = UDim.new(0, 12)})

    local header = make("Frame", {
        Parent = panel,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = COLOR.header,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
    })
    make("UICorner", {Parent = header, CornerRadius = UDim.new(0, 12)})
    make("Frame", {
        Parent = header,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = COLOR.header,
        BackgroundTransparency = ALPHA,
        BorderSizePixel = 0,
    })

    make("TextLabel", {
        Parent = header,
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Botao minimizar (sempre presente)
    local minimize = make("TextButton", {
        Parent = header,
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, noClose and -28 or -54, 0.5, -11),
        BackgroundColor3 = Color3.fromRGB(40, 10, 10),
        BackgroundTransparency = 0.3,
        Text = "-",
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })
    make("UICorner", {Parent = minimize, CornerRadius = UDim.new(0, 6)})

    minimize.MouseEnter:Connect(function()
        tween(minimize, 0.15, {BackgroundColor3 = COLOR.accent, BackgroundTransparency = 0})
    end)
    minimize.MouseLeave:Connect(function()
        tween(minimize, 0.15, {
            BackgroundColor3 = Color3.fromRGB(40, 10, 10),
            BackgroundTransparency = 0.3,
        })
    end)

    -- Botao fechar (so se noClose for false)
    if not noClose then
        local close = make("TextButton", {
            Parent = header,
            Size = UDim2.new(0, 22, 0, 22),
            Position = UDim2.new(1, -28, 0.5, -11),
            BackgroundColor3 = Color3.fromRGB(40, 10, 10),
            BackgroundTransparency = 0.3,
            Text = "X",
            TextColor3 = COLOR.text,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            BorderSizePixel = 0,
            AutoButtonColor = false,
        })
        make("UICorner", {Parent = close, CornerRadius = UDim.new(0, 6)})

        close.MouseEnter:Connect(function()
            tween(close, 0.15, {BackgroundColor3 = COLOR.accent, BackgroundTransparency = 0})
        end)
        close.MouseLeave:Connect(function()
            tween(close, 0.15, {
                BackgroundColor3 = Color3.fromRGB(40, 10, 10),
                BackgroundTransparency = 0.3,
            })
        end)
        close.MouseButton1Click:Connect(function()
            confirmarFechar(gui)
        end)
    end

    -- Sistema de minimizar
    local minimizado = false

    minimize.MouseButton1Click:Connect(function()
        minimizado = not minimizado

        if minimizado then
            tween(panel, 0.2, {Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 34)})
            minimize.Text = "+"
        else
            tween(panel, 0.2, {Size = size})
            minimize.Text = "-"
        end
    end)

    -- Registra no array global
    table.insert(allPanels, panel)

    return gui, panel, header
end

local function makeButton(parent, text, height)
    local btn = make("TextButton", {
        Parent = parent,
        Size = UDim2.new(1, -20, 0, height or 40),
        BackgroundColor3 = COLOR.bg2,
        BackgroundTransparency = ALPHA,
        Text = text,
        TextColor3 = COLOR.text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })
    make("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
    make("UIStroke", {Parent = btn, Color = COLOR.strokeDim, Thickness = 1})

    btn.MouseEnter:Connect(function()
        tween(btn, 0.15, {BackgroundColor3 = COLOR.bg3, BackgroundTransparency = 0})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.15, {BackgroundColor3 = COLOR.bg2, BackgroundTransparency = ALPHA})
    end)

    return btn
end

