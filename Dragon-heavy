local wOn = false

local function segurar()
    if wOn then return end
    wOn = true
    bW.BackgroundColor3 = Color3.fromRGB(180, 10, 10)
    bW.Text = "ON"
    pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.W, false, game) end)
end

local function soltar()
    if not wOn then return end
    wOn = false
    bW.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    bW.Text = "W"
    pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game) end)
end

bW.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        segurar()
    end
end)

bW.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        soltar()
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch and wOn then soltar() end
end)

